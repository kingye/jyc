/target

# Runtime data directory (contains credentials)
.jyc/
!templates/*/.jyc/
!templates/*/.jyc/**

# Local test data (inbound attachments dropped in the repo root)
attachments/

# Config files with credentials
config.toml
config.test.toml
# ...but the subagent roles this repo ships are config.toml by design
!subagents/*/config.toml

# Docker env (contains local paths)
docker/.env
docker/.env.proxy

# JYC binary and backup (for systemd supervision)
jyc
jyc.bak
.DS_Store
# data directory (contains runtime data, logs, and credentials)
jyc-data 

*.tar.gz
*-mcps.toml
**/__pycache__/
.opencode/

# Local runtime state when the data dir == repo root
/channels/
/auth.token
/nohup.out
/jyc.log
/jyc-pipe

# Runtime context payload the agent framework drops in the topic dir
agent-context.jsonl.payload
